load_module modules/ngx_http_sundew_module.so;

user nginx;
worker_processes 2;
error_log @RUN@/error.log debug;
pid @RUN@/nginx.pid;

events {
    worker_connections 128;
}

http {
    access_log off;
    limit_req_zone $binary_remote_addr zone=z:1m rate=100r/s;
    @SETS@

    server {
        listen 127.0.0.1:8080;

        location /t { sundew_debug_test; }

        location /order {
            set_real_ip_from 127.0.0.1;
            real_ip_header X-Forwarded-For;
            limit_req zone=z burst=10;
            alias @RUN@/order.txt;
        }
        location /  { return 200 "ok\n"; }
    }
}
