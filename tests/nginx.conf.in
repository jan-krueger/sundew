load_module modules/ngx_http_sundew_module.so;

user nginx;
worker_processes 2;
error_log @RUN@/error.log debug;
pid @RUN@/nginx.pid;
env ASAN_OPTIONS;
env UBSAN_OPTIONS;
@MAIN@

events {
    worker_connections 1024;
}

http {
    access_log off;
    limit_req_zone $binary_remote_addr zone=z:1m rate=1000r/s;
    add_header X-Sundew "$ipset_result $ipset_matched_set" always;
    @SETS@
    @HTTP@

    server {
        listen 127.0.0.1:8080;
        listen [::1]:8080;
        listen 127.0.0.1:8081 http2;
        @H3@

        ssl_certificate     @RUN@/cert.pem;
        ssl_certificate_key @RUN@/key.pem;

        set_real_ip_from 127.0.0.1;
        set_real_ip_from ::1;
        real_ip_header X-Forwarded-For;

        root @RUN@/www;

        location = /stats   { ipset_denylist off; ipset_stats; }
        location = /metrics { ipset_denylist off; ipset_metrics; }
        @LOC@
    }

    server {
        listen 127.0.0.1:8082;

        location /order {
            set_real_ip_from 127.0.0.1;
            real_ip_header X-Forwarded-For;
            limit_req zone=z burst=10;
            alias @RUN@/www/index.html;
        }
    }
}
